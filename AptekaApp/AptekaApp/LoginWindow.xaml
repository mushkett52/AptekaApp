<Window x:Class="AptekaApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Интернет-аптека"
        Height="450" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFEDEBE5"
        KeyDown="Window_KeyDown">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <TextBlock Text="Интернет-аптека"
                   FontSize="25"
                   FontWeight="Bold"
                   Foreground="#1F3A2E"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,25"/>

        
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Логин" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginTextBox"
                     Height="34" Padding="8" FontSize="14"/>
        </StackPanel>

       
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="Пароль" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordInput"
                         Height="34" Padding="8" FontSize="14"/>
        </StackPanel>

        
            <Button Grid.Row="3"
        Content="Войти как администратор"
        Height="40"
        FontSize="13"
        FontWeight="SemiBold"
        Background="#2457A7"
        Foreground="White"
        BorderThickness="0"
        Cursor="Hand"
        Click="AdminLoginButton_Click"
        Margin="0,0,0,10"
                />
            
        

       
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Height="1" Background="#D0D7E2" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="или" Foreground="#888" Margin="10,0"/>
            <Border Grid.Column="2" Height="1" Background="#D0D7E2" VerticalAlignment="Center"/>
        </Grid>

        
        <Button Grid.Row="5"
                Content="Войти как пользователь без авторизации"
                Height="40"
                FontSize="14"
                FontWeight="SemiBold"
                Background="#FF3B8C3E"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Click="GuestLoginButton_Click"
                VerticalAlignment="Top"/>
    </Grid>
</Window>