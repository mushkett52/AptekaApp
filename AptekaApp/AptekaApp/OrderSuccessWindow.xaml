<Window x:Class="AptekaApp.OrderSuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ оформлен"
        Height="620" Width="800"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#F5EFE0">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,30,0,0">

            <TextBlock Text="✅"
                       FontSize="70"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Заказ успешно оформлен!"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#1F3A2E"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <TextBlock Text="Ваш номер заказа"
                       FontSize="18"
                       Foreground="#666"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <Border Background="#F5EFE0"
                    CornerRadius="15"
                    Padding="40,18"
                    BorderBrush="#2457A7"
                    BorderThickness="3"
                    HorizontalAlignment="Center">
                <TextBlock x:Name="OrderNumberText"
                           Text="ORD-0000"
                           FontSize="52"
                           FontWeight="Bold"
                           Foreground="#1F3A2E"
                           HorizontalAlignment="Center"/>
            </Border>

            <TextBlock Text="Сохраните номер — по нему вы сможете отследить статус заказа"
                       FontSize="13"
                       Foreground="#888"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>

            <Border x:Name="PrescriptionNotice"
                    Background="#FFEBEE"
                    BorderBrush="#E53935"
                    BorderThickness="2"
                    CornerRadius="10"
                    Padding="20,12"
                    Margin="0,20,0,0"
                    MaxWidth="600"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💊"
                               FontSize="28"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>
                    <TextBlock Text="В составе заказа есть рецептурные препараты. При получении предъявите рецепт врача."
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#B71C1C"
                               TextWrapping="Wrap"
                               MaxWidth="480"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TimerText"
                       Text="Автоматический возврат через 10 сек..."
                       FontSize="13"
                       Foreground="#B00"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,30">
            <Button Content="🔄 Следующий заказ"
                    Width="240" Height="60"
                    Margin="10"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Background="#1F3A2E"
                    Foreground="#F5EFE0"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="NextOrder_Click"/>

            <Button Content="🏠 Вернуться на главную"
                    Width="260" Height="60"
                    Margin="10"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Background="#FF224D90"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BackToWelcome_Click"/>
        </StackPanel>
    </Grid>
</Window>