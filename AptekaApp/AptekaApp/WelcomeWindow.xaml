<Window x:Class="AptekaApp.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Интернет-аптека — Добро пожаловать"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#FFEDEBE5">

    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="🏥"
                       FontSize="100"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Добро пожаловать!"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="#1F3A2E"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Нажмите кнопку ниже, чтобы начать работу"
                       FontSize="20"
                       Foreground="#666"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,60"/>

            <Button Content="▶ НАЧАТЬ"
                    Width="360" Height="90"
                    FontSize="28"
                    FontWeight="Bold"
                    Background="#FF3B8C3E"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="Start_Click"/>
        </StackPanel>
    </Grid>
</Window>