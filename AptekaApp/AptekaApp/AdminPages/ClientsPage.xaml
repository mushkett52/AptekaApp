<Page x:Class="AptekaApp.ClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Клиенты"
      Background="#F2F5F9">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок + поиск -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Клиенты"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#FF3B8C3E"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="SearchBox"
                     DockPanel.Dock="Right"
                     Width="300" Height="30"
                     Padding="5"
                     VerticalAlignment="Center"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="Поиск по ФИО, телефону"/>
        </DockPanel>

        <DataGrid x:Name="ClientsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="ClientsGrid_SelectionChanged"
                  CanUserAddRows="False"
                  AlternatingRowBackground="#F5F8FC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"        Binding="{Binding id_client}" Width="50"/>
                <DataGridTextColumn Header="Фамилия"   Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="Имя"       Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="Отчество"  Binding="{Binding Patronymic}" Width="*"/>
                <DataGridTextColumn Header="Телефон"   Binding="{Binding Telephone}" Width="*"/>
                <DataGridTextColumn Header="Email"     Binding="{Binding Email}" Width="*"/>
                <DataGridTextColumn Header="Адрес"     Binding="{Binding Adress}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <UniformGrid Columns="4" Rows="2">
                <Label Content="Фамилия:" VerticalAlignment="Center"/>
                <TextBox x:Name="LastNameTextBox" Margin="2"/>

                <Label Content="Имя:" VerticalAlignment="Center"/>
                <TextBox x:Name="FirstNameTextBox" Margin="2"/>

                <Label Content="Отчество:" VerticalAlignment="Center"/>
                <TextBox x:Name="PatronymicTextBox" Margin="2"/>

                <Label Content="Телефон:" VerticalAlignment="Center"/>
                <TextBox x:Name="PhoneTextBox" Margin="2"/>

                <Label Content="Email:" VerticalAlignment="Center"/>
                <TextBox x:Name="EmailTextBox" Margin="2"/>

                <Label Content="Адрес:" VerticalAlignment="Center"/>
                <TextBox x:Name="AddressTextBox" Margin="2"/>
            </UniformGrid>

            <UniformGrid Columns="4" Margin="0,30,0,0">
                <Button Content="Добавить"  Margin="5" Click="AddButton_Click"/>
                <Button Content="Изменить"  Margin="5" Click="UpdateButton_Click"/>
                <Button Content="Удалить"   Margin="5" Click="DeleteButton_Click"/>
                <Button Content="Очистить"  Margin="5" Click="ClearButton_Click"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Page>