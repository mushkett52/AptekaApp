<Page x:Class="AptekaApp.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Заказы" Background="#F2F5F9">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Заказы"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#FF3B8C3E"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="SearchBox"
                     DockPanel.Dock="Right"
                     Width="300"
                     Height="30"
                     Padding="5"
                     VerticalAlignment="Center"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="Поиск по номеру заказа, клиенту, статусу"/>
        </DockPanel>

        <DataGrid x:Name="OrdersGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="OrdersGrid_SelectionChanged"
                  CanUserAddRows="False"
                  AlternatingRowBackground="#F5EFE0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id_order}" Width="50"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding orderNumber}" Width="100"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding kurs_Client.LastName, TargetNullValue='Аноним'}" Width="*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding orderDate, StringFormat=dd.MM.yyyy}" Width="110"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding sum, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding kurs_Status.name}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <UniformGrid Columns="4" Rows="2">
                <Label Content="Клиент:" VerticalAlignment="Center"/>
                <ComboBox x:Name="ClientComboBox"
                          DisplayMemberPath="LastName"
                          SelectedValuePath="id_client"
                          Margin="2"/>

                <Label Content="Дата заказа:" VerticalAlignment="Center"/>
                <DatePicker x:Name="OrderDatePicker" Margin="2" IsEnabled="False"/>

                <Label Content="Статус:" VerticalAlignment="Center"/>
                <ComboBox x:Name="StatusComboBox"
                          DisplayMemberPath="name"
                          SelectedValuePath="id_status"
                          Margin="2"/>

                <Label Content="Сумма:" VerticalAlignment="Center"/>
                <TextBox x:Name="SumTextBox" Margin="2" IsReadOnly="True" Background="#EEE"/>
            </UniformGrid>

            <UniformGrid Columns="5" Margin="0,10,0,0">
                <Button Content="Состав заказа" Margin="5" Click="EditComposition_Click"/>
                <Button Content="Добавить"      Margin="5" Click="AddButton_Click"/>
                <Button Content="Изменить"      Margin="5" Click="UpdateButton_Click"/>
                <Button Content="Удалить"       Margin="5" Click="DeleteButton_Click"/>
                <Button Content="Очистить"      Margin="5" Click="ClearButton_Click"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Page>