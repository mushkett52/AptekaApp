<Page x:Class="AptekaApp.SuppliersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Поставщики" Background="#F2F5F9">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Поставщики"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#FF3B8C3E"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="SearchBox"
                     DockPanel.Dock="Right"
                     Width="300" Height="30"
                     Padding="5"
                     VerticalAlignment="Center"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="Поиск по названию, контактному лицу"/>
        </DockPanel>

        <DataGrid x:Name="SuppliersGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="SuppliersGrid_SelectionChanged"
                  CanUserAddRows="False"
                  AlternatingRowBackground="#F5EFE0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"              Binding="{Binding id_supplier}" Width="50"/>
                <DataGridTextColumn Header="Название"        Binding="{Binding name}" Width="*"/>
                <DataGridTextColumn Header="Телефон"         Binding="{Binding Telephone}" Width="*"/>
                <DataGridTextColumn Header="Контактное лицо" Binding="{Binding ContactPerson}" Width="*"/>
                <DataGridTextColumn Header="Email"           Binding="{Binding email}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <UniformGrid Columns="2" Rows="4">
                <Label Content="Название:" VerticalAlignment="Center"/>
                <TextBox x:Name="NameTextBox" Margin="2"/>

                <Label Content="Телефон:" VerticalAlignment="Center"/>
                <TextBox x:Name="PhoneTextBox" Margin="2"/>

                <Label Content="Контактное лицо:" VerticalAlignment="Center"/>
                <TextBox x:Name="ContactPersonTextBox" Margin="2"/>

                <Label Content="Email:" VerticalAlignment="Center"/>
                <TextBox x:Name="EmailTextBox" Margin="2"/>
            </UniformGrid>

            <UniformGrid Columns="4" Margin="0,10,0,0">
                <Button Content="Добавить"  Margin="5" Click="AddButton_Click"/>
                <Button Content="Изменить"  Margin="5" Click="UpdateButton_Click"/>
                <Button Content="Удалить"   Margin="5" Click="DeleteButton_Click"/>
                <Button Content="Очистить"  Margin="5" Click="ClearButton_Click"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Page>