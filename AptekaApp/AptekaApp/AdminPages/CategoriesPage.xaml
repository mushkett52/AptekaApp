<Page x:Class="AptekaApp.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Категории" Background="#F2F5F9">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Категории лекарств"
                   FontSize="20" FontWeight="Bold"
                   Foreground="#FF3B8C3E" Margin="0,0,0,10"/>

        <DataGrid x:Name="CategoriesGrid" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False"
                  SelectionChanged="CategoriesGrid_SelectionChanged"
                  AlternatingRowBackground="#F5EFE0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"        Binding="{Binding id_category}" Width="60"/>
                <DataGridTextColumn Header="Название"  Binding="{Binding name}" Width="*"/>
                <DataGridTextColumn Header="Описание"  Binding="{Binding description}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <UniformGrid Columns="2" Rows="2">
                <Label Content="Название:" VerticalAlignment="Center"/>
                <TextBox x:Name="NameTextBox" Margin="2"/>
                <Label Content="Описание:" VerticalAlignment="Center"/>
                <TextBox x:Name="DescriptionTextBox" Margin="2"/>
            </UniformGrid>

            <UniformGrid Columns="4" Margin="0,10,0,0">
                <Button Content="Добавить"  Margin="5" Click="AddButton_Click"/>
                <Button Content="Изменить"  Margin="5" Click="UpdateButton_Click"/>
                <Button Content="Удалить"   Margin="5" Click="DeleteButton_Click"/>
                <Button Content="Очистить"  Margin="5" Click="ClearButton_Click"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Page>