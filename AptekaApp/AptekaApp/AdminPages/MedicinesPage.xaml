<Page x:Class="AptekaApp.MedicinesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Лекарства"
      Background="#F2F5F9">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Каталог лекарств"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#1F3A2E"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="SearchBox"
                     DockPanel.Dock="Right"
                     Width="300" Height="30"
                     Padding="5"
                     VerticalAlignment="Center"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="Поиск по названию, производителю, категории"/>
        </DockPanel>

        <DataGrid x:Name="MedicinesGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="MedicinesGrid_SelectionChanged"
                  CanUserAddRows="False"
                  AlternatingRowBackground="#EBE3D0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding id_Medicine}" Width="50"/>
                <DataGridTemplateColumn Header="Фото" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding imageUrl}" Width="40" Height="40" Stretch="Uniform" Margin="2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Название" Binding="{Binding name}" Width="*"/>
                <DataGridTextColumn Header="Производитель" Binding="{Binding manufacturer}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding kurs_Category.name}" Width="*"/>
                <DataGridTextColumn Header="Поставщик" Binding="{Binding kurs_Supplier.name}" Width="*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding price, StringFormat=N2}" Width="80"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding amount}" Width="70"/>
                <DataGridTextColumn Header="Мин. ост." Binding="{Binding minAmount}" Width="70"/>
                <DataGridTextColumn Header="Срок годн." Binding="{Binding expDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridCheckBoxColumn Header="Рецепт" Binding="{Binding prescription}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="320" Margin="0,10,0,0">
            <StackPanel>
                <UniformGrid Columns="4" Rows="2">
                    <Label Content="Название:" VerticalAlignment="Center"/>
                    <TextBox x:Name="NameTextBox" Margin="2"/>

                    <Label Content="Производитель:" VerticalAlignment="Center"/>
                    <TextBox x:Name="ManufacturerTextBox" Margin="2"/>

                    <Label Content="Категория:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CategoryComboBox"
                              DisplayMemberPath="name"
                              SelectedValuePath="id_category"
                              Margin="2"/>

                    <Label Content="Поставщик:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="SupplierComboBox"
                              DisplayMemberPath="name"
                              SelectedValuePath="id_supplier"
                              Margin="2"/>
                </UniformGrid>

                <UniformGrid Columns="4" Rows="2" Margin="0,5,0,0">
                    <Label Content="Цена:" VerticalAlignment="Center"/>
                    <TextBox x:Name="PriceTextBox" Margin="2"/>

                    <Label Content="Количество:" VerticalAlignment="Center"/>
                    <TextBox x:Name="AmountTextBox" Margin="2"/>

                    <Label Content="Мин. остаток:" VerticalAlignment="Center"/>
                    <TextBox x:Name="MinAmountTextBox" Margin="2"/>

                    <Label Content="Срок годности:" VerticalAlignment="Center"/>
                    <DatePicker x:Name="ExpDatePicker" Margin="2"/>

                    <Label Content="Рецептурный:" VerticalAlignment="Center"/>
                    <CheckBox x:Name="PrescriptionCheckBox" Margin="2" VerticalAlignment="Center"/>
                </UniformGrid>

                <UniformGrid Columns="2" Rows="1" Margin="0,30,0,0">
                    <Label Content="URL изображения:" VerticalAlignment="Center"/>
                    <TextBox x:Name="ImageUrlTextBox" Margin="2"/>
                </UniformGrid>

                <UniformGrid Columns="4" Margin="0,10,0,0">
                    <Button Content="Добавить"  Margin="5" Click="AddButton_Click"/>
                    <Button Content="Изменить"  Margin="5" Click="UpdateButton_Click"/>
                    <Button Content="Удалить"   Margin="5" Click="DeleteButton_Click"/>
                    <Button Content="Очистить"  Margin="5" Click="ClearButton_Click"/>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>