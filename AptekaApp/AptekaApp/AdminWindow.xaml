<Window x:Class="AptekaApp.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Интернет-аптека — Панель администратора"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F2F5F9">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="15,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#3A6FC4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1F3A2E">
            <StackPanel>
                <TextBlock Text="Интернет-аптека"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#F5EFE0"
                           Margin="20,25,20,5"/>
                <TextBlock x:Name="UserInfoText"
                           FontSize="12" Foreground="#B8CCE8"
                           Margin="20,0,20,25"/>

                <Button Content="💊  Лекарства"    Style="{StaticResource MenuButtonStyle}" Click="MenuMedicines_Click"/>
                <Button Content="📁  Категории"    Style="{StaticResource MenuButtonStyle}" Click="MenuCategories_Click"/>
                <Button Content="🚚  Поставщики"   Style="{StaticResource MenuButtonStyle}" Click="MenuSuppliers_Click"/>
                <Button Content="🛒  Заказы"       Style="{StaticResource MenuButtonStyle}" Click="MenuOrders_Click"/>
                <Button Content="🚪  Выйти"        Style="{StaticResource MenuButtonStyle}" Click="Logout_Click" Margin="10,40,10,10"/>
            </StackPanel>
        </Border>

        <Frame Grid.Column="1" x:Name="MainFrame"
               NavigationUIVisibility="Hidden"
               Background="#F2F5F9"/>
    </Grid>
</Window>