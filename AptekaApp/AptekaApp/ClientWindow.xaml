<Window x:Class="AptekaApp.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Интернет-аптека — Терминал"
        Height="750" Width="1300"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#FFEDEBE5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FF2F7132"
                CornerRadius="8"
                Padding="15,10"
                Margin="0,0,0,12">
            <DockPanel>
                <TextBlock x:Name="UserGreetingText"
                           Text="Вы вошли как: Аноним"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="White"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                            <TextBlock Text="🔍 Поиск по названию / производителю"
                                       FontWeight="SemiBold"
                                       Foreground="#555"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="SearchBox"
                                     Height="32" Padding="6"
                                     FontSize="14"
                                     TextChanged="FilterChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Категория"
                                       FontWeight="SemiBold"
                                       Foreground="#555"
                                       Margin="0,0,0,4"/>
                            <ComboBox x:Name="CategoryFilterComboBox"
                                      DisplayMemberPath="name"
                                      SelectedValuePath="id_category"
                                      Height="32"
                                      SelectionChanged="FilterChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Цена, ₽ (от и до)"
                                       FontWeight="SemiBold"
                                       Foreground="#555"
                                       Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PriceFromBox"
                                         Grid.Column="0"
                                         Height="32" Padding="6"
                                         TextChanged="FilterChanged"/>
                                <TextBlock Grid.Column="1"
                                           Text=" — "
                                           VerticalAlignment="Center"
                                           Foreground="#888"/>
                                <TextBox x:Name="PriceToBox"
                                         Grid.Column="2"
                                         Height="32" Padding="6"
                                         TextChanged="FilterChanged"/>
                            </Grid>
                        </StackPanel>

                        <Button Grid.Row="1" Grid.Column="2"
                                Content="Сбросить"
                                Width="110" Height="32"
                                VerticalAlignment="Bottom"
                                Background="#E0E6F0"
                                Foreground="#1F3A2E"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="ResetFilters_Click"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Background="Transparent">
                    <ItemsControl x:Name="MedicinesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="280" Height="380" Background="White" CornerRadius="8" Margin="0,0,10,10" Padding="15" BorderBrush="#D0D7E2" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="140"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="#F2F5F9" CornerRadius="5" Margin="0,0,0,10">
                                            <Image Source="{Binding imageUrl}" Stretch="Uniform" Margin="5"/>
                                        </Border>

                                        <TextBlock Grid.Row="1" Text="{Binding name}" FontSize="15" FontWeight="Bold" Foreground="#1F3A2E" TextWrapping="Wrap" MaxHeight="40"/>

                                        <!-- Плашка РЕЦЕПТУРНЫЙ (если нужно) -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,5">
                                            <TextBlock Text="{Binding manufacturer}" FontSize="11" Foreground="#888" TextTrimming="CharacterEllipsis" Width="150"/>
                                            <Border Background="#E53935" CornerRadius="3" Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding prescription}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="РЕЦЕПТ" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3">
                                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="#333" Text="{Binding price, StringFormat='{}{0:N2} ₽'}"/>
                                            <TextBlock FontSize="12" Foreground="#555" Margin="0,2,0,0">
                <Run Text="В наличии: "/><Run Text="{Binding amount}" FontWeight="SemiBold"/><Run Text=" шт."/>
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Row="4" Content="🛒 Заказать" Height="32" Margin="0,5,0,0" Background="#4CAF50" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="AddToCart_Click" Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="15"
                    BorderBrush="#D0D7E2"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="🛒 Корзина"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#2457A7"
                               Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CartList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#EEE"
                                            BorderThickness="0,0,0,1"
                                            Padding="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0"
                                                        Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <Border Background="#E53935"
                                                        CornerRadius="3"
                                                        Padding="5,1"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPrescription}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="РЕЦЕПТУРНЫЙ"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                       Foreground="#888"
                                                       FontSize="12">
                                                <Run Text="{Binding Price, StringFormat='{}{0:N2} ₽', Mode=OneWay}"/>
                                                <Run Text=" × "/>
                                                <Run Text="{Binding Amount, Mode=OneWay}"/>
                                                <Run Text=" = "/>
                                                <Run Text="{Binding Total, StringFormat='{}{0:N2} ₽', Mode=OneWay}"
                                                     FontWeight="SemiBold"
                                                     Foreground="#333"/>
                                            </TextBlock>

                                            <StackPanel Grid.Row="0" Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="−"
                                                        Width="24" Height="24"
                                                        Click="DecreaseQty_Click"
                                                        Tag="{Binding}"/>
                                                <TextBlock Text="{Binding Amount, Mode=OneWay}"
                                                           Width="30"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <Button Content="+"
                                                        Width="24" Height="24"
                                                        Click="IncreaseQty_Click"
                                                        Tag="{Binding}"/>
                                            </StackPanel>

                                            <Button Grid.Row="0" Grid.Column="2"
                                                    Content="✕"
                                                    Width="24" Height="24"
                                                    Margin="5,0,0,0"
                                                    Background="#E53935"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Click="RemoveFromCart_Click"
                                                    Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" x:Name="PrescriptionWarning"
                            Background="#FFEBEE"
                            BorderBrush="#E53935"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            Margin="0,10,0,5"
                            Visibility="Collapsed">
                        <TextBlock Text="⚠ При выдаче потребуется рецепт от врача"
                                   Foreground="#B71C1C"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <Border Grid.Row="3"
                            BorderBrush="#D0D7E2"
                            BorderThickness="0,1,0,0"
                            Padding="0,10"
                            Margin="0,5,0,0">
                        <DockPanel>
                            <TextBlock Text="Итого:"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalText"
                                       DockPanel.Dock="Right"
                                       Text="0.00 ₽"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#2457A7"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <Button Content="✅ Оформить заказ"
                                Height="45"
                                FontSize="15"
                                FontWeight="Bold"
                                Background="#FF7BB17D"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="Checkout_Click"
                                Margin="0,0,0,8"/>
                        <Button Content="🗑 Очистить корзину"
                                Height="34"
                                Background="#F0F0F0"
                                Foreground="#555"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="ClearCart_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>