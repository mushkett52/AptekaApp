<Window x:Class="AptekaApp.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Интернет-аптека — Табло заказов"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F5EFE0">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1F3A2E"
                CornerRadius="10"
                Padding="25,15"
                Margin="0,0,0,20">
            <DockPanel>
                <TextBlock Text="🏥  ТАБЛО ЗАКАЗОВ"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#F5EFE0"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="ClockText"
                           DockPanel.Dock="Right"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#F5EFE0"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    CornerRadius="10"
                    Padding="20"
                    BorderBrush="#1F3A2E"
                    BorderThickness="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#FF344D88"
                            CornerRadius="6"
                            Padding="15,8"
                            Margin="0,0,0,15">
                        <TextBlock Text="В ПРОЦЕССЕ"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#F5EFE0"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="InProgressList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F5EFE0"
                                            BorderBrush="#1F3A2E"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="15,10"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding OrderNumber}"
                                                       FontSize="24"
                                                       FontWeight="Bold"
                                                       Foreground="#1F3A2E"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StatusName}"
                                                       FontSize="14"
                                                       Foreground="#1F3A2E"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#FFFFFF"
                    CornerRadius="10"
                    Padding="20"
                    BorderBrush="#4CAF50"
                    BorderThickness="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#4CAF50"
                            CornerRadius="6"
                            Padding="15,8"
                            Margin="0,0,0,15">
                        <TextBlock Text="ГОТОВ К ВЫДАЧЕ"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ReadyList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#E8F5E9"
                                            BorderBrush="#4CAF50"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="15,10"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding OrderNumber}"
                                                       FontSize="24"
                                                       FontWeight="Bold"
                                                       Foreground="#1F3A2E"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StatusName}"
                                                       FontSize="14"
                                                       Foreground="#2E7D32"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#1F3A2E"
                CornerRadius="10"
                Padding="20,10"
                Margin="0,20,0,0">
            <DockPanel>
               
                <TextBlock x:Name="UpdateTimeText"
                           DockPanel.Dock="Right"
                           FontSize="14"
                           Foreground="#F5EFE0"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>